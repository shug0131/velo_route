# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRAVA_CLIENT_ID & STRAVA_CLIENT_SECRET: OAuth credentials from https://www.strava.com/settings/api
# Configure these in AI Studio Secrets to enable Strava ride sync.
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""

# INTERVALS_CLIENT_ID & INTERVALS_CLIENT_SECRET: Intervals.icu OAuth app credentials (optional if using INTERVALS_API_KEY)
# Or set INTERVALS_API_KEY from https://intervals.icu/settings for personal API access.
INTERVALS_CLIENT_ID=""
INTERVALS_CLIENT_SECRET=""
INTERVALS_API_KEY=""
